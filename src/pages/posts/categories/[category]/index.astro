---
/**
 * 文章分类页 /posts/categories/[category]（矿层页）
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import PlaceholderArt from '@/components/PlaceholderArt.astro';
import { categories } from '@/config/site';

export async function getStaticPaths() {
  const allPosts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return categories.map((c) => ({
    params: { category: c.key },
    props: {
      category: c,
      posts: allPosts
        .filter((p) => p.data.category === c.key)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { category, posts } = Astro.props;
const icon =
  category.kind === 'surface' ? 'tree' : category.kind === 'cave' ? 'pick' : category.kind === 'deep' ? 'gem' : 'fire';
---

<BaseLayout title={`${category.name} · 冒险日志`} description={`${category.name}（${category.tagline}）分类下的文章。`}>
  <main id="main" class="page">
    <div class="page__inner">
      <p class="crumb font-pixel">
        <a href="/posts/"><PixelIcon name="arrow" size={14} /> 返回日志列表</a>
      </p>
      <SectionHeading
        icon={icon}
        title={`${category.name}矿层`}
        subtitle={`${category.tagline} · 共 ${posts.length} 篇`}
      />
      <ul class="cat-tabs">
        {
          categories.map((c) => (
            <li>
              <a
                class="px-chip"
                href={`/posts/categories/${c.key}/`}
                aria-current={c.key === category.key ? 'page' : undefined}
              >
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {
              posts.map((post) => (
                <li><PostCard post={post} /></li>
              ))
            }
          </ul>
        ) : (
          <PlaceholderArt icon={icon} label={`${category.name}矿层还没被挖到——文章正在路上。`} tall={true} />
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    padding: 48px 16px 72px;
  }
  .page__inner {
    max-width: 860px;
    margin-inline: auto;
  }
  .crumb {
    margin: 0 0 18px;
    font-size: 14px;
  }
  .crumb a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
    text-decoration: none;
  }
  .crumb a svg {
    transform: rotate(180deg);
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .cat-tabs {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .cat-tabs .px-chip {
    text-decoration: none;
  }
  .cat-tabs .px-chip:hover {
    background: var(--accent-3);
    color: var(--ink-raw);
  }
  .cat-tabs .px-chip[aria-current="page"] {
    background: var(--accent);
    color: var(--text-on-accent);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (max-width: 767px) {
    .page {
      padding-top: 32px;
    }
  }
</style>
