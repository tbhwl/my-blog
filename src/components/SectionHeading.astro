---
/**
 * 区块标题：像素图标 + 标题 + 副标题（可带「查看更多」按钮）
 */
import PixelIcon from './PixelIcon.astro';

interface Props {
  icon: string;
  title: string;
  subtitle?: string;
  href?: string;
  hrefLabel?: string;
  /** 深色区块内使用浅色文字 */
  light?: boolean;
  /** 标题锚点 id（供 aria-labelledby 引用） */
  id?: string;
}

const { icon, title, subtitle, href, hrefLabel = '查看更多', light = false, id } = Astro.props;
---

<div class="section-heading">
  <span class="section-heading__icon px-card px-bevel"><PixelIcon name={icon} size={24} /></span>
  <div class="section-heading__text">
    <h2 class="px-heading" class:list={{ 'px-heading--light': light }} id={id}>{title}</h2>
    {
      subtitle && (
        <p class="section-heading__sub" class:list={{ 'is-light': light }}>{subtitle}</p>
      )
    }
  </div>
  {
    href && (
      <a class="px-btn px-btn--ghost px-btn--sm" href={href}>
        {hrefLabel} <PixelIcon name="arrow" size={16} />
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .section-heading__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-3);
    color: var(--ink-raw);
    flex-shrink: 0;
  }
  .section-heading__text {
    flex: 1;
    min-width: 200px;
  }
  h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.3;
  }
  .section-heading__sub {
    margin: 4px 0 0;
    color: var(--text-soft);
    font-size: 15px;
  }
  .section-heading__sub.is-light {
    color: var(--bg-panel);
  }
  @media (max-width: 767px) {
    h2 {
      font-size: 24px;
    }
  }
</style>
