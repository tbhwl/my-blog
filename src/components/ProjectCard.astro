---
/**
 * 项目卡片：封面 / 状态 / 名称 / 简介 / 功能 / 技术标签 / 入口
 */
import type { CollectionEntry } from 'astro:content';
import PixelIcon from './PixelIcon.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import { resolveRepoUrl } from '@/utils/content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, tagline, description, status, tech, cover, features } = project.data;
const repoUrl = resolveRepoUrl(project.data.repoKey);
const href = `/projects/${project.id}/`;

const statusMeta = {
  completed: { label: '已完成', icon: 'star', cls: 'is-done' },
  active: { label: '进行中', icon: 'pick', cls: 'is-active' },
  paused: { label: '暂时搁置', icon: 'clock', cls: 'is-paused' },
}[status];
---

<article class="px-card px-bevel project-card">
  <a class="project-card__cover" href={href} aria-hidden="true" tabindex={-1}>
    {
      cover ? (
        <img src={cover} alt={`${name} 封面`} class="pixel-art" loading="lazy" />
      ) : (
        <PlaceholderArt icon="map" label="待补充：项目封面" />
      )
    }
  </a>
  <div class="project-card__body">
    <div class="project-card__top">
      <span class={`px-chip status-chip ${statusMeta.cls}`}>
        <PixelIcon name={statusMeta.icon} size={14} /> {statusMeta.label}
      </span>
      {
        repoUrl && (
          <a class="project-card__repo" href={repoUrl} target="_blank" rel="noopener noreferrer">
            <PixelIcon name="github" size={16} /> 仓库
          </a>
        )
      }
    </div>
    <h3 class="project-card__title font-pixel">
      <a href={href}>{name}</a>
    </h3>
    <p class="project-card__tagline">{tagline}</p>
    <p class="project-card__desc">{description}</p>
    {
      features.length > 0 && (
        <ul class="project-card__features">
          {
            features.slice(0, 3).map((f) => (
              <li><PixelIcon name="gem" size={12} /> {f}</li>
            ))
          }
        </ul>
      )
    }
    <div class="project-card__bottom">
      <ul class="project-card__tech">
        {
          tech.length > 0
            ? tech.map((t) => <li class="px-chip">{t}</li>)
            : <li class="px-chip is-pending"><PixelIcon name="question" size={14} /> 技术待补充</li>
        }
      </ul>
      <a class="px-btn px-btn--sm" href={href}>
        查看详情 <PixelIcon name="arrow" size={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .project-card__cover {
    display: block;
    border-bottom: 3px solid var(--line);
    background: var(--bg-surface-2);
  }
  .project-card__cover img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .project-card__cover .placeholder-box {
    border: none;
    min-height: 180px;
    flex-direction: column;
  }
  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    flex: 1;
  }
  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .status-chip.is-done {
    background: var(--accent-2);
    color: var(--text-on-accent);
  }
  .status-chip.is-active {
    background: var(--accent);
    color: var(--text-on-accent);
  }
  .status-chip.is-paused {
    background: var(--bg-panel);
    color: var(--text-faint);
  }
  .project-card__repo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-pixel-name);
    -webkit-font-smoothing: none;
    font-size: 14px;
    color: var(--text-soft);
    text-decoration: none;
  }
  .project-card__repo:hover {
    color: var(--accent);
  }
  .project-card__title {
    margin: 0;
    font-size: 22px;
    line-height: 1.4;
  }
  .project-card__title a {
    color: var(--text-main);
    text-decoration: none;
  }
  .project-card__title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .project-card__tagline {
    margin: 0;
    color: var(--accent);
    font-size: 14.5px;
    font-weight: 600;
  }
  .project-card__desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 14px;
    line-height: 1.8;
  }
  .project-card__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .project-card__features li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
    font-size: 13.5px;
  }
  .project-card__features svg {
    color: var(--accent-2);
    flex-shrink: 0;
  }
  .project-card__bottom {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .project-card__tech {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-card__tech .px-chip {
    font-size: 12px;
    padding: 2px 8px;
  }
  .project-card__tech .is-pending {
    border-style: dashed;
    color: var(--text-faint);
  }
</style>
