---
/**
 * 像素冒险者头像（原创像素画，非任何游戏素材）
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 128, class: className } = Astro.props;

// 16×16 像素画：#H 头发 #F 皮肤 #E 眼睛 #B 上衣 #S 手 #L 裤子 #O 靴子
const GRID = [
  '................',
  '.....HHHHHH.....',
  '....HHHHHHHH....',
  '....HHHHHHHH....',
  '.....FFFFFF.....',
  '....FEFEFF......',
  '....FFFFFF......',
  '.....FFFF.......',
  '....BBBBBB......',
  '...BBBBBBBB.....',
  '...BSBBBBBS.....',
  '...BBBBBBBB.....',
  '...BBBBBBBB.....',
  '....BB..BB......',
  '....LL..LL......',
  '...OOL..LOO.....',
];

const COLORS: Record<string, string> = {
  H: '#6b4a2f',
  F: '#f5c79e',
  E: '#2b1d12',
  B: '#4a7fd4',
  S: '#f5c79e',
  L: '#3a3a44',
  O: '#6b4a2f',
};

const rects = GRID.map((row, y) =>
  [...row]
    .map((c, x) => (COLORS[c] ? `<rect x="${x}" y="${y}" width="1" height="1" fill="${COLORS[c]}"/>` : ''))
    .join(''),
).join('');
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  class={className}
  role="img"
  aria-label="像素冒险者头像"
  shape-rendering="crispEdges"
  set:html={rects}
/>
