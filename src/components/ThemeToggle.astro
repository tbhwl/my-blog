---
/**
 * 白天 / 夜晚主题切换按钮。
 * 界面名称叫「白天」「夜晚」；切换有太阳/月亮逐帧动画；记住用户选择；
 * 未手动选择时跟随系统主题；尊重系统减少动态效果设置。
 */
import PixelIcon from './PixelIcon.astro';
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="切换白天 / 夜晚主题"
  title="切换主题"
>
  <span class="theme-icon theme-icon--day" aria-hidden="true"><PixelIcon name="sun" size={24} /></span>
  <span class="theme-icon theme-icon--night" aria-hidden="true"><PixelIcon name="moon" size={24} /></span>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  if (button) {
    // 捕获非空引用，供内部闭包安全使用
    const btn = button;
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    function readSaved(): string | null {
      try {
        return localStorage.getItem('theme');
      } catch {
        return null;
      }
    }

    function apply(isNight: boolean, save: boolean) {
      root.setAttribute('data-theme', isNight ? 'night' : 'day');
      root.style.colorScheme = isNight ? 'dark' : 'light';
      if (save) {
        try {
          localStorage.setItem('theme', isNight ? 'night' : 'day');
        } catch {
          /* 隐私模式下忽略 */
        }
      }
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', isNight ? '#0b1026' : '#8fd3ff');
      btn.title = isNight ? '切换到白天主题' : '切换到夜晚主题';
    }

    function currentIsNight(): boolean {
      const saved = readSaved();
      return saved !== null ? saved === 'night' : media.matches;
    }

    // 初始化提示文字
    btn.title = currentIsNight() ? '切换到白天主题' : '切换到夜晚主题';

    btn.addEventListener('click', () => {
      btn.classList.remove('is-switching');
      // 强制重排以重新触发动画
      void btn.offsetWidth;
      btn.classList.add('is-switching');
      apply(!currentIsNight(), true);
    });

    // 用户没有手动选择时，实时跟随系统主题变化
    media.addEventListener('change', (e) => {
      if (readSaved() === null) apply(e.matches, false);
    });
  }
</script>
