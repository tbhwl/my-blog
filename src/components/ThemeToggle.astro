---
/**
 * 白天 / 夜晚主题切换按钮。
 * 界面名称叫「白天」「夜晚」；切换有太阳/月亮逐帧动画；记住用户选择；
 * 未手动选择时跟随系统主题；尊重系统减少动态效果设置。
 */
import PixelIcon from './PixelIcon.astro';
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="切换到夜晚"
  title="切换主题"
>
  <span class="theme-icon theme-icon--day" aria-hidden="true"><PixelIcon name="sun" size={24} /></span>
  <span class="theme-icon theme-icon--night" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" shape-rendering="crispEdges">
      <mask id="theme-toggle-moon-cutout" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
        <rect width="24" height="24" fill="white" />
        <circle cx="16" cy="7" r="9" fill="black" />
      </mask>
      <circle cx="11" cy="13" r="9" fill="currentColor" mask="url(#theme-toggle-moon-cutout)" />
    </svg>
  </span>
</button>
