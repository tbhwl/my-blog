  .map((row, y) =>
    [...row]
      .map((c, x) => (c === '#' ? `<rect x="${x}" y="${y}" width="1" height="1"/>` : ''))
      .join(''),
  )
  .join('');
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  class={className}
  role="img"
  aria-hidden="true"
  shape-rendering="crispEdges"
  fill="currentColor"
  set:html={rects}
/>
